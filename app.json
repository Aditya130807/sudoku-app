{
  "expo": {
    "name": "sudoku-app",
    "slug": "sudoku-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sudokuapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pandey_sachin11.sudokuapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "./plugins/with-admob-app-ids.js",
        {
          "androidAppId": "ca-app-pub-8048301971162422~8360590993",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "extra": {
      "admob": {
        "androidBannerUnitId": "ca-app-pub-8048301971162422/3047292788",
        "iosBannerUnitId": "",
        "androidInterstitialUnitId": "ca-app-pub-8048301971162422/4817765958",
        "iosInterstitialUnitId": "",
        "androidRewardedUnitId": "ca-app-pub-8048301971162422/8654842680",
        "iosRewardedUnitId": ""
      }
    },
    "experiments": {
      "reactCompiler": true
    }
  }
}
