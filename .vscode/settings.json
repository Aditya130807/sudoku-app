{
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit",
    "source.sortMembers": "explicit"
  },
  "chat.tools.terminal.autoApprove": {
    "/^\\$files = Get-ChildItem -Path src,utils -Recurse -File -Include \\*\\.ts,\\*\\.tsx,\\*\\.js; \\$files \\+= Get-Item App\\.tsx; \\$uniquePaths = \\$files\\.FullName \\| Select-Object -Unique; \\$results = Select-String -Path \\$uniquePaths -Pattern 'console\\\\\\.\\(log\\|debug\\)'; if \\(\\$results\\) \\{ \\$results \\| ForEach-Object \\{ \"\\{0\\}:\\{1\\}: \\{2\\}\" -f \\$_\\.Path, \\$_\\.LineNumber, \\$_\\.Line\\.Trim\\(\\) \\} \\} else \\{ 'NO_DEBUG_LOGS_FOUND' \\}$/": {
      "approve": true,
      "matchCommandLine": true
    }
  }
}
