rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidUserData(data) {
      return data.keys().hasOnly([
          'coins',
          'progress',
          'stats',
          'createdAt',
          'lastLogin',
          'migratedFromGuest',
          'migratedGuestId',
        ])
        && data.keys().hasAll(['coins'])
        && data.coins is int
        && data.coins >= 0
        && (!('progress' in data) || data.progress is map)
        && (!('stats' in data) || data.stats is map)
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('lastLogin' in data) || data.lastLogin is timestamp)
        && (!('migratedFromGuest' in data) || data.migratedFromGuest is bool)
        && (!('migratedGuestId' in data) || data.migratedGuestId is string);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
        && (request.resource == null || isValidUserData(request.resource.data));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
